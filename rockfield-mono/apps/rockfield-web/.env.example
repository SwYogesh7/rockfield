# Rockfield — environment variables
# Copy this to .env.local and fill in values. Never commit .env.local.

# ── Public (safe for browser) ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only (never expose to browser) ─────────────────────────────────
# Payment provider — use "mock" for local/offline development
PAYMENT_PROVIDER=mock
DATABASE_URL=postgresql://user:password@localhost:5432/rockfield
REDIS_URL=redis://localhost:6379
